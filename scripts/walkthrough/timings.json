[{"id": "s01", "lang": "en", "text": "April 2024. In just one week, NASA satellites picked up more than three thousand fire detections across Uttarakhand's forests.", "dur": 11.64, "words": [[0.102083, 2.029166, "April 2024"], [2.942708, 3.111999, "In"], [3.125, 3.476583, "just"], [3.489583, 3.776041, "one"], [3.789083, 4.166708, "week"], [4.466166, 4.934916, "NASA"], [4.947916, 5.664082, "satellites"], [5.677083, 5.989583, "picked"], [6.002625, 6.184916, "up"], [6.197916, 6.432291, "more"], [6.445333, 6.666708, "than"], [6.679708, 6.966166, "three"], [6.979166, 7.460957, "thousand"], [7.473958, 7.838541, "fire"], [7.851583, 8.580749, "detections"], [8.59375, 9.101583, "across"], [9.114583, 9.960958, "Uttarakhand's"], [9.973958, 10.677083, "forests"]]}, {"id": "s02", "lang": "en", "text": "Every spring, the chir pine hills burn. And every spring, forest staff find out only after the smoke rises.", "dur": 9.456, "words": [[0.102083, 0.479708, "Every"], [0.492708, 1.052624, "spring"], [1.273958, 1.391166, "the"], [1.404166, 1.625541, "chir"], [1.638541, 1.977082, "pine"], [1.990125, 2.289625, "hills"], [2.302625, 2.745333, "burn"], [3.684916, 3.867207, "And"], [3.880208, 4.218749, "every"], [4.231791, 4.778666, "spring"], [5.052083, 5.533874, "forest"], [5.546875, 5.859375, "staff"], [5.872416, 6.223999, "find"], [6.237, 6.614625, "out"], [6.627625, 6.953166, "only"], [6.966166, 7.278666, "after"], [7.291666, 7.382832, "the"], [7.395833, 7.799499, "smoke"], [7.8125, 8.476583, "rises"]]}, {"id": "s03", "lang": "en", "text": "This is Van Agni. It tells them where fire is likely next week, so the patrol gets there first.", "dur": 8.088, "words": [[0.102083, 0.401583, "This"], [0.414583, 0.596874, "is"], [0.609916, 0.883374, "Van"], [0.896375, 1.365125, "Agni"], [2.369791, 2.526041, "It"], [2.539083, 2.851583, "tells"], [2.864583, 3.072916, "them"], [3.085958, 3.268249, "where"], [3.28125, 3.737, "fire"], [3.75, 3.880208, "is"], [3.89325, 4.322958, "likely"], [4.335958, 4.700541, "next"], [4.713541, 5.065124, "week"], [5.3125, 5.481791, "so"], [5.494791, 5.585957, "the"], [5.598958, 6.093749, "patrol"], [6.106791, 6.419291, "gets"], [6.432291, 6.601582, "there"], [6.614583, 7.135416, "first"]]}, {"id": "s04", "lang": "en", "text": "Every morning at six, a free GitHub job pulls NASA's latest satellite fire feed and the weather, and rescores 113 forest cells across Uttarakhand, each about 27 kilometres wide. The colour is the chance of fire in the next seven days.", "dur": 18.84, "words": [[0.102083, 0.427624, "Every"], [0.440625, 0.844291, "morning"], [0.857291, 1.000541, "at"], [1.013541, 1.469291, "six"], [1.807833, 1.885958, "a"], [1.898958, 2.198458, "free"], [2.211458, 2.615124, "GitHub"], [2.628125, 2.927625, "job"], [2.940625, 3.305208, "pulls"], [3.31825, 3.904208, "NASA's"], [3.917208, 4.385958, "latest"], [4.398958, 4.958874, "satellite"], [4.971875, 5.375541, "fire"], [5.388541, 5.818249, "feed"], [5.83125, 6.000541, "and"], [6.013541, 6.117707, "the"], [6.13075, 6.625541, "weather"], [6.833875, 7.029208, "and"], [7.042208, 7.680249, "rescores"], [7.69325, 8.904166, "113"], [8.917208, 9.398999, "forest"], [9.412, 9.698458, "cells"], [9.711458, 10.167208, "across"], [10.180208, 11.039583, "Uttarakhand"], [11.326041, 11.534374, "each"], [11.547416, 11.911999, "about"], [11.925, 12.6542069, "27"], [12.667208, 13.383374, "kilometres"], [13.396375, 13.800041, "wide"], [14.765625, 14.882833, "The"], [14.895833, 15.286458, "colour"], [15.2995, 15.416708, "is"], [15.429708, 15.533874, "the"], [15.546875, 15.950541, "chance"], [15.963541, 16.080749, "of"], [16.09375, 16.497416, "fire"], [16.510416, 16.601582, "in"], [16.614583, 16.692708, "the"], [16.70575, 17.083375, "next"], [17.096375, 17.434916, "seven"], [17.447916, 17.851582, "days"]]}, {"id": "s05", "lang": "en", "text": "Now the real test. We rewind to the 22nd of April, 2024, and ask Van Agni for its top ten patrol list, using only what was known that morning. Then we play the next seven days of satellite fires on top.", "dur": 18.384, "words": [[0.102083, 0.440624, "Now"], [0.453666, 0.557832, "the"], [0.570833, 0.883333, "real"], [0.896375, 1.456291, "test"], [2.408875, 2.578166, "We"], [2.591166, 3.125041, "rewind"], [3.138041, 3.229207, "to"], [3.242208, 3.346374, "the"], [3.359375, 4.205749, "22nd"], [4.21875, 4.388041, "of"], [4.401041, 4.947916, "April"], [5.195333, 6.627625, "2024"], [6.862, 7.057333, "and"], [7.070333, 7.408874, "ask"], [7.421875, 7.734375, "Van"], [7.747416, 8.098999, "Agni"], [8.112, 8.333375, "for"], [8.346375, 8.58075, "its"], [8.59375, 8.867208, "top"], [8.880208, 9.166666, "ten"], [9.179708, 9.609416, "patrol"], [9.622416, 10.052124, "list"], [10.286458, 10.716166, "using"], [10.729166, 11.028666, "only"], [11.041666, 11.302082, "what"], [11.315125, 11.523458, "was"], [11.536458, 11.835958, "known"], [11.848958, 12.070333, "that"], [12.083333, 12.630208, "morning"], [13.554708, 13.880249, "Then"], [13.89325, 14.023458, "we"], [14.036458, 14.322916, "play"], [14.335958, 14.440124, "the"], [14.453125, 14.882833, "next"], [14.895833, 15.221374, "seven"], [15.234375, 15.520833, "days"], [15.533875, 15.677125, "of"], [15.690125, 16.341166, "satellite"], [16.354166, 16.809916, "fires"], [16.822916, 17.005207, "on"], [17.01825, 17.382833, "top"]]}, {"id": "s06", "lang": "en", "text": "All ten burned. Ten out of ten.", "dur": 4.224, "words": [[0.102083, 0.362499, "All"], [0.375541, 0.727124, "ten"], [0.740125, 1.195875, "burned"], [2.1745, 2.434916, "Ten"], [2.447916, 2.682291, "out"], [2.695333, 2.825541, "of"], [2.838541, 3.307291, "ten"]]}, {"id": "s07", "lang": "en", "text": "Every cell on the list comes with an alert in English and Hindi, and the reasons behind it. 49 days without rain. Humidity at 24 percent. 44 fire points nearby this week.", "dur": 16.488, "words": [[0.102083, 0.479708, "Every"], [0.492708, 0.779166, "cell"], [0.792208, 0.909416, "on"], [0.922416, 0.974499, "the"], [0.9875, 1.326041, "list"], [1.339083, 1.729708, "comes"], [1.742708, 1.924999, "with"], [1.938041, 2.068249, "an"], [2.08125, 2.484916, "alert"], [2.497916, 2.615124, "in"], [2.628125, 3.00575, "English"], [3.01875, 3.214083, "and"], [3.227083, 3.760958, "Hindi"], [4.021375, 4.203666, "and"], [4.216666, 4.281791, "the"], [4.294791, 4.789582, "reasons"], [4.802625, 5.284416, "behind"], [5.297416, 5.583874, "it"], [6.5495, 7.3177489, "49"], [7.33075, 7.721375, "days"], [7.734375, 8.203125, "without"], [8.216166, 8.684916, "rain"], [9.622416, 10.364624, "Humidity"], [10.377625, 10.572958, "at"], [10.585958, 11.2109579, "24"], [11.223958, 11.822916, "percent"], [12.8125, 13.541666, "44"], [13.554708, 13.932333, "fire"], [13.945333, 14.388041, "points"], [14.401041, 14.856791, "nearby"], [14.869791, 15.104166, "this"], [15.117208, 15.507833, "week"]]}, {"id": "s08", "lang": "hi", "text": "वन अग्नि: अगले सात दिन, अति उच्च आग जोखिम। केवल सलाह: बीट स्टाफ से पुष्टि करें।", "dur": 10.056, "words": [[0.1, 0.451583, "वन"], [0.464583, 1.024499, "अग्नि"], [1.245833, 1.688541, "अगले"], [1.701583, 2.131291, "सात"], [2.144291, 2.717207, "दिन"], [2.873458, 3.290124, "अति"], [3.303125, 3.706791, "उच्च"], [3.719791, 4.058332, "आग"], [4.071375, 4.657333, "जोखिम"], [5.557833, 6.000541, "केवल"], [6.013541, 6.651582, "सलाह"], [6.938041, 7.367749, "बीट"], [7.38075, 7.784416, "स्टाफ"], [7.797416, 8.005749, "से"], [8.01875, 8.448458, "पुष्टि"], [8.461458, 9.138541, "करें"]]}, {"id": "s09", "lang": "en", "text": "It is advice, not an order. The beat officer always decides.", "dur": 6.528, "words": [[0.102083, 0.245333, "It"], [0.258333, 0.401583, "is"], [0.414583, 1.065624, "advice"], [1.260958, 1.638583, "not"], [1.651583, 1.794833, "an"], [1.807833, 2.276583, "order"], [3.242208, 3.372416, "The"], [3.385416, 3.684916, "beat"], [3.697916, 4.309916, "officer"], [4.322916, 4.843749, "always"], [4.856791, 5.533874, "decides"]]}, {"id": "s10", "lang": "en", "text": "On 2025, a year the model never saw, Van Agni scores an area under the curve of 0.914. Its daily top ten catches 38.6 percent of the cells that burn, against 20.4 percent for the usual way of watching past hotspots. That's 89 percent more fires reached, with the same ten patrols.", "dur": 26.304, "words": [[0.102083, 0.284374, "On"], [0.297416, 1.859916, "2025"], [2.133333, 2.185416, "a"], [2.198458, 2.497958, "year"], [2.510958, 2.615124, "the"], [2.628125, 3.044791, "model"], [3.057833, 3.383374, "never"], [3.396375, 3.760958, "saw"], [3.995333, 4.307833, "Van"], [4.320833, 4.659374, "Agni"], [4.672416, 5.115124, "scores"], [5.128125, 5.3625, "an"], [5.375541, 5.818249, "area"], [5.83125, 6.078666, "under"], [6.091666, 6.182832, "the"], [6.195833, 6.534374, "curve"], [6.547416, 6.677624, "of"], [6.690625, 8.513582, "0.914"], [9.453125, 9.648458, "Its"], [9.661458, 10.065124, "daily"], [10.078125, 10.377625, "top"], [10.390625, 10.651041, "ten"], [10.664083, 11.145874, "catches"], [11.158875, 12.552083, "38.6"], [12.565125, 13.020875, "percent"], [13.033875, 13.125041, "of"], [13.138041, 13.255249, "the"], [13.26825, 13.658875, "cells"], [13.671875, 13.867208, "that"], [13.880208, 14.309916, "burn"], [14.609375, 15.130208, "against"], [15.14325, 16.145833, "20.4"], [16.158875, 16.627625, "percent"], [16.640625, 16.783875, "for"], [16.796875, 16.940125, "the"], [16.953125, 17.408875, "usual"], [17.421875, 17.630208, "way"], [17.64325, 17.825541, "of"], [17.838541, 18.255207, "watching"], [18.26825, 18.632833, "past"], [18.645833, 19.453124, "hotspots"], [20.429708, 20.924499, "That's"], [20.9375, 21.575541, "89"], [21.588541, 22.070332, "percent"], [22.083333, 22.317708, "more"], [22.33075, 22.7995, "fires"], [22.8125, 23.307291, "reached"], [23.554708, 23.671916, "with"], [23.684916, 23.802124, "the"], [23.815125, 24.218791, "same"], [24.231791, 24.544291, "ten"], [24.557291, 25.338541, "patrols"]]}, {"id": "s11", "lang": "en", "text": "What drives it? The fire radiative power and satellite detections of the past week lead, then each cell's own fire history, the season, and ninety days of rain.", "dur": 12.816, "words": [[0.102083, 0.375541, "What"], [0.388541, 0.792207, "drives"], [0.805208, 1.117708, "it"], [2.03125, 2.148458, "The"], [2.161458, 2.682291, "fire"], [2.695333, 3.333374, "radiative"], [3.346375, 3.841166, "power"], [3.854166, 3.997416, "and"], [4.010416, 4.596374, "satellite"], [4.609375, 5.273458, "detections"], [5.286458, 5.377624, "of"], [5.390625, 5.494791, "the"], [5.507833, 5.950541, "past"], [5.963541, 6.223957, "week"], [6.237, 6.562541, "lead"], [6.862, 7.200541, "then"], [7.213541, 7.499999, "each"], [7.513041, 7.916707, "cell's"], [7.929708, 8.151083, "own"], [8.164083, 8.567749, "fire"], [8.58075, 9.140666, "history"], [9.348958, 9.479166, "the"], [9.492208, 10.091166, "season"], [10.325541, 10.507832, "and"], [10.520833, 10.898458, "ninety"], [10.911458, 11.210958, "days"], [11.223958, 11.406249, "of"], [11.419291, 11.875041, "rain"]]}, {"id": "s12", "lang": "en", "text": "And it's green by design. Training takes under five seconds on an ordinary laptop processor. That's 0.00023 kilowatt hours, about a sixth of a gram of carbon dioxide. Scoring a thousand cells costs six hundred-thousandths of a gram. No large language model runs at all.", "dur": 24.096, "words": [[0.102083, 0.258333, "And"], [0.271375, 0.453666, "it's"], [0.466666, 0.870332, "green"], [0.883333, 1.078666, "by"], [1.091666, 1.729707, "design"], [2.669291, 3.138041, "Training"], [3.151041, 3.476582, "takes"], [3.489583, 3.736999, "under"], [3.75, 4.088541, "five"], [4.101583, 4.661499, "seconds"], [4.6745, 4.81775, "on"], [4.83075, 4.974, "an"], [4.987, 5.481791, "ordinary"], [5.494791, 5.976582, "laptop"], [5.989583, 6.614583, "processor"], [7.526041, 7.916666, "That's"], [7.929708, 10.5599159, "0.00023"], [10.572916, 11.132832, "kilowatt"], [11.145833, 11.536458, "hours"], [11.783875, 12.148458, "about"], [12.161458, 12.213541, "a"], [12.226583, 12.643249, "sixth"], [12.65625, 12.8125, "of"], [12.825541, 12.903666, "a"], [12.916666, 13.307291, "gram"], [13.320333, 13.489624, "of"], [13.502625, 14.010458, "carbon"], [14.023458, 14.791708, "dioxide"], [15.716166, 16.223999, "Scoring"], [16.237, 16.289083, "a"], [16.302083, 16.822916, "thousand"], [16.835958, 17.174499, "cells"], [17.1875, 17.773458, "costs"], [17.786458, 18.111999, "six"], [18.125, 18.919291, "hundred-thousandths"], [18.932291, 19.088541, "of"], [19.101583, 19.166708, "a"], [19.179708, 19.661499, "gram"], [20.612, 20.859416, "No"], [20.872416, 21.289082, "large"], [21.302083, 21.796874, "language"], [21.809916, 22.187541, "model"], [22.200541, 22.565124, "runs"], [22.578125, 22.747416, "at"], [22.760416, 23.111999, "all"]]}, {"id": "s13", "lang": "en", "text": "The code is open. Feature building, training with year by year splits, passing tests, and one script that reproduces every number in this video.", "dur": 11.448, "words": [[0.102083, 0.219291, "The"], [0.232291, 0.531791, "code"], [0.544791, 0.701041, "is"], [0.714083, 1.182833, "open"], [2.096375, 2.552125, "Feature"], [2.565125, 3.085958, "building"], [3.320333, 3.736999, "training"], [3.75, 3.945333, "with"], [3.958333, 4.192708, "year"], [4.20575, 4.375041, "by"], [4.388041, 4.622416, "year"], [4.635416, 5.169291, "splits"], [5.390625, 5.859375, "passing"], [5.872416, 6.406291, "tests"], [6.653666, 6.901082, "and"], [6.914083, 7.200541, "one"], [7.213541, 7.734374, "script"], [7.747416, 8.007832, "that"], [8.020833, 8.854166, "reproduces"], [8.867208, 9.192749, "every"], [9.20575, 9.635458, "number"], [9.648458, 9.778666, "in"], [9.791666, 10.026041, "this"], [10.039083, 10.468791, "video"]]}, {"id": "s14", "lang": "en", "text": "It deploys four ways. Free cloud, Docker, on premise, or SMS at the edge, for forest beats with no internet. Next is a pilot, from February to June 2027, in Nainital or Almora.", "dur": 18.048, "words": [[0.102083, 0.219291, "It"], [0.232291, 0.766166, "deploys"], [0.779166, 1.117707, "four"], [1.13075, 1.560458, "ways"], [2.552083, 2.877624, "Free"], [2.890625, 3.4375, "cloud"], [3.619791, 4.166666, "Docker"], [4.375, 4.544291, "on"], [4.557291, 5.143249, "premise"], [5.351583, 5.664083, "or"], [5.677083, 6.328124, "SMS"], [6.341166, 6.484416, "at"], [6.497416, 6.679707, "the"], [6.692708, 7.070333, "edge"], [7.395833, 7.539083, "for"], [7.552083, 8.085958, "forest"], [8.098958, 8.515624, "beats"], [8.528666, 8.736999, "with"], [8.75, 9.010416, "no"], [9.023458, 9.713583, "internet"], [10.690125, 11.119833, "Next"], [11.132833, 11.236999, "is"], [11.25, 11.315125, "a"], [11.328125, 11.888041, "pilot"], [12.148458, 12.382833, "from"], [12.395833, 12.994791, "February"], [13.007833, 13.138041, "to"], [13.151041, 15.091166, "June 2027"], [15.338541, 15.533874, "in"], [15.546875, 16.210958, "Nainital"], [16.223958, 16.484374, "or"], [16.497416, 17.057332, "Almora"]]}, {"id": "s15", "lang": "en", "text": "Van Agni. See the fire before it starts.", "dur": 4.968, "words": [[0.102083, 0.492708, "Van"], [0.50575, 1.039625, "Agni"], [1.979166, 2.252624, "See"], [2.265625, 2.382833, "the"], [2.395833, 2.812499, "fire"], [2.825541, 3.255249, "before"], [3.26825, 3.385458, "it"], [3.398458, 3.997416, "starts"]]}]